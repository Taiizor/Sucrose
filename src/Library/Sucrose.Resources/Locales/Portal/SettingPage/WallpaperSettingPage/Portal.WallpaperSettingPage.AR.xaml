<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.WallpaperSettingPage.Title">WallpaperSettingPage</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.InputMode">طريقة التفاعل</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.InputMode.Description">تحدّد الطرق التي يمكن من خلالها التفاعل مع خلفيات الشاشة المدعومة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.InputMode.InputModule">وحدة التفاعل:</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.InputMode.InputDesktop">معالجة التفاعل فقط عندما يكون سطح المكتب قيد التركيز</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.InputMode.DesktopIcon">الإخفاء لتجنّب تحديد أيقونات سطح المكتب عن طريق الخطأ</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.ScreenLayout">تخطيط الشاشة</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.ScreenLayout.Description">غيّر تخطيط خلفيات الشاشة لديك على الشاشة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.StretchMode">وضع التمدّد</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.StretchMode.Description">غيّر وضع التحجيم لخلفيات الشاشة المدعومة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.StayAwake">البقاء نشطًا</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.StayAwake.Description">تغيّر حالة البقاء نشطًا لخلفيات الشاشة المدعومة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.CrashMode">وضع التعطّل</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.CrashMode.Description">تغيّر سلوك إعادة تحميل خلفية الشاشة عند تعطّل سطح المكتب أو إغلاقه.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.LoopMode">وضع التكرار</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.LoopMode.Description">تغيّر سلوك التكرار لخلفيات الشاشة المدعومة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.ShuffleMode">وضع الخلط</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.ShuffleMode.Description">غيّر سلوك الخلط لخلفيات الشاشة المدعومة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.DisableSlideshowLive">عرض شرائح Windows</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.DisableSlideshowLive.Description">يُوقف عرض شرائح Windows تلقائيًا عند تطبيق خلفية حيّة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.BackgroundImage">صورة الخلفية</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.BackgroundImage.Description">تغيّر الخلفية الحيّة إلى صورة خلفية لسطح المكتب.</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.BackgroundImage.DisableSlideshow">تعطيل عرض شرائح Windows</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.HardwareAcceleration">تسريع الأجهزة</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.HardwareAcceleration.Description">تغيّر سلوك تسريع الأجهزة لخلفيات الشاشة المدعومة.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.GifPlayer">مشغّل Gif</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.GifPlayer.Description">حدّد الإضافة التي ستشغّل سِمات Gif في مكتبتك.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.VideoPlayer">مشغّل Video</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.VideoPlayer.Description">حدّد الإضافة التي ستشغّل سِمات Video في مكتبتك.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.UrlPlayer">محرّك Url</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.UrlPlayer.Description">حدّد المحرّك الذي سيشغّل سِمات Url في مكتبتك.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.WebPlayer">محرّك Web</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.WebPlayer.Description">حدّد المحرّك الذي سيشغّل سِمات Web في مكتبتك.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.YouTubePlayer">محرّك YouTube</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.YouTubePlayer.Description">حدّد المحرّك الذي سيشغّل سِمات YouTube في مكتبتك.</system:String>

    <system:String x:Key="Portal.WallpaperSettingPage.ApplicationPlayer">محرّك Application</system:String>
    <system:String x:Key="Portal.WallpaperSettingPage.ApplicationPlayer.Description">حدّد المحرّك الذي سيشغّل سِمات Application في مكتبتك.</system:String>
</ResourceDictionary>