<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <system:String x:Key="Portal.LibraryCard.TitleText">Title</system:String>
    <system:String x:Key="Portal.LibraryCard.DescriptionText">Description</system:String>

    <system:String x:Key="Portal.LibraryCard.MoreTip">More</system:String>
    <system:String x:Key="Portal.LibraryCard.VersionTip">Update Sucrose to use this theme</system:String>

    <system:String x:Key="Portal.LibraryCard.MenuUse">Use</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuEdit">Edit</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuFind">Find</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuShare">Share</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuDelete">Delete</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuReview">Review</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuPreview">Preview</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuCustomize">Customize</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuCyclingAdd">Add to Cycle</system:String>
    <system:String x:Key="Portal.LibraryCard.MenuCyclingRemove">Remove from Cycle</system:String>

    <system:String x:Key="Portal.LibraryCard.MenuLockScreen">Set as lock screen</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenClose">Close</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenAdminTitle">Lock screen requires administrator rights</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenAdminMessage">Windows protects the lock-screen cache. An administrator prompt will appear to replace the cached images with this GIF.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenAdminApply">Continue</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenModeTitle">Lock screen is not in Picture mode</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenModeMessage">Open Windows Settings, Personalization, Lock screen and choose Picture, then lock and unlock Windows once. Otherwise the GIF may not appear.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenModeContinue">Continue anyway</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFFmpegTitle">FFmpeg is required for videos</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFFmpegMessage">Video themes are converted to GIF with FFmpeg first. Download the FFmpeg package now (about 80 MB, one time)?</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFFmpegDownload">Download</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenErrorTitle">Lock screen could not be set</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenErrorMessage">The lock-screen image could not be prepared: {0}</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenDoneTitle">Lock screen request sent</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenDoneMessage">Lock Windows (Win + L) to check the animation. If it still shows a still image, choose a Picture lock screen in Windows Settings and retry.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenAppliedMessage">The GIF was written to {0} lock-screen images. Lock Windows (Win + L) to check the animation. If it still shows a still image, choose a Picture lock screen in Windows Settings and retry.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenTimeoutMessage">The helper did not report back in time. Lock Windows (Win + L) to check; if nothing changed, retry.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFeatureTitle">Windows is blocking lock-screen animation</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFeatureMessage">Windows 11 keeps lock-screen animation off through system feature 38943831. Turn it off now? Administrator approval is required and a restart is needed afterwards. Also keep Settings, Accessibility, Visual effects, Animation effects turned on.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFeatureDisable">Turn off</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFeatureHintTitle">If the animation still does not play</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenFeatureHintMessage">Keep Settings, Accessibility, Visual effects, Animation effects turned on. On Windows 11 25H2 and later the system feature 38943831 must also be off; this check could not read its state.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenRebootTitle">Restart required</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenRebootMessage">The Windows feature change needs a restart to take effect. Restart now? Save your work first.</system:String>
    <system:String x:Key="Portal.LibraryCard.LockScreenRebootNow">Restart now</system:String>
    <system:String x:Key="Portal.LibraryCard.Closed">Closed</system:String>
    <system:String x:Key="Portal.LibraryCard.Paused">Paused</system:String>

    <system:String x:Key="Portal.LibraryCard.Selected">Selected</system:String>

    <system:String x:Key="Portal.LibraryCard.Incompatible">Incompatible</system:String>
</ResourceDictionary>