<ui:ContentDialog
    x:Class="Sucrose.Portal.Views.Controls.DisplayPreferences"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Portal.DisplayPreferences.Title}"
    d:DesignHeight="600"
    d:DesignWidth="775"
    CloseButtonText="{DynamicResource Portal.DisplayPreferences.Close}"
    DialogMaxWidth="775"
    Loaded="ContentDialog_Loaded"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:DisplayPreferences}" />
    </ui:ContentDialog.Resources>

    <StackPanel
        x:Name="Panel"
        MinWidth="620"
        MinHeight="9999"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Orientation="Vertical">
        <Border
            x:Name="PreviewBorder"
            MinHeight="250"
            Margin="0,0,0,12"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            ClipToBounds="True"
            CornerRadius="8">
            <Canvas
                x:Name="Contents"
                Width="680"
                Height="230"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <ui:Card Background="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        FontSize="20"
                        Symbol="DualScreenSpan24" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top">
                        <ui:TextBlock Text="{DynamicResource Portal.DisplayPreferences.Expander}" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Portal.DisplayPreferences.Expander.Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="32,12,0,0">
                    <RadioButton
                        x:Name="ModeScreen"
                        Content="{DynamicResource Portal.DisplayPreferences.Screen}"
                        GroupName="DisplayType" />
                    <RadioButton
                        x:Name="ModeExpand"
                        Margin="16,0,0,0"
                        Content="{DynamicResource Portal.DisplayPreferences.Expand}"
                        GroupName="DisplayType" />
                    <RadioButton
                        x:Name="ModeDuplicate"
                        Margin="16,0,0,0"
                        Content="{DynamicResource Portal.DisplayPreferences.Duplicate}"
                        GroupName="DisplayType"
                        IsEnabled="False" />
                </WrapPanel>

                <StackPanel
                    x:Name="ExpandOptions"
                    Margin="32,12,0,0"
                    Visibility="Collapsed">
                    <ui:TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.DisplayPreferences.Expand.Hint}"
                        TextWrapping="Wrap" />
                    <WrapPanel x:Name="ExpandTypeList" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel
                    x:Name="DuplicateOptions"
                    Margin="32,12,0,0"
                    Visibility="Collapsed">
                    <ui:TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.DisplayPreferences.Duplicate.Hint}"
                        TextWrapping="Wrap" />
                    <WrapPanel x:Name="DuplicateTypeList" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</ui:ContentDialog>