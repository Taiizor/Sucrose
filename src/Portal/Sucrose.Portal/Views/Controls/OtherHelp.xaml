<ui:ContentDialog
    x:Class="Sucrose.Portal.Views.Controls.OtherHelp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Portal.OtherHelp.Title}"
    d:DesignHeight="470"
    d:DesignWidth="640"
    CloseButtonText="{DynamicResource Portal.OtherHelp.Close}"
    DialogMaxWidth="640"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:OtherHelp}" />
    </ui:ContentDialog.Resources>

    <StackPanel
        MinWidth="440"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center">

        <ui:CardAction
            Click="WebPage_Click"
            Icon="{ui:SymbolIcon WebAsset24,
                                 FontSize=24}"
            IsChevronVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.OtherHelp.WebPage}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.OtherHelp.WebPage.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:SymbolIcon
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Open24" />
            </Grid>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,4,0,0"
            Click="Documentation_Click"
            Icon="{ui:SymbolIcon BookOpenGlobe24,
                                 FontSize=24}"
            IsChevronVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.OtherHelp.Documentation}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.OtherHelp.Documentation.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:SymbolIcon
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Open24" />
            </Grid>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,4,0,0"
            Click="Repository_Click"
            Icon="{ui:SymbolIcon CodeBlock24,
                                 FontSize=24}"
            IsChevronVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.OtherHelp.Repository}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.OtherHelp.Repository.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:SymbolIcon
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Open24" />
            </Grid>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,4,0,0"
            Click="Discussions_Click"
            Icon="{ui:SymbolIcon GlobePerson24,
                                 FontSize=24}"
            IsChevronVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.OtherHelp.Discussions}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.OtherHelp.Discussions.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:SymbolIcon
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Open24" />
            </Grid>
        </ui:CardAction>

        <ui:CardAction
            Margin="0,4,0,0"
            Click="Report_Click"
            Icon="{ui:SymbolIcon Bug24,
                                 FontSize=24}"
            IsChevronVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.OtherHelp.Report}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.OtherHelp.Report.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ui:SymbolIcon
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Open24" />
            </Grid>
        </ui:CardAction>
    </StackPanel>
</ui:ContentDialog>