<ui:ContentDialog
    x:Class="Sucrose.Portal.Views.Controls.ThemeImport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Portal.ThemeImport.Title}"
    d:DesignHeight="480"
    d:DesignWidth="750"
    CloseButtonText="{DynamicResource Portal.ThemeImport.Close}"
    DialogMaxWidth="750"
    Loaded="ContentDialog_Loaded"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:ThemeImport}" />
    </ui:ContentDialog.Resources>

    <StackPanel
        x:Name="Panel"
        MinWidth="500"
        MinHeight="9999"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Orientation="Vertical">
        <ui:Card
            x:Name="MessageCard"
            Background="{DynamicResource CardStrokeColorDefaultBrush}"
            Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Info24" />

                    <ui:TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.ThemeImport.Info}"
                        TextWrapping="Wrap" />
                </Grid>

                <WrapPanel
                    x:Name="ThemeImportMessage"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical" />
            </StackPanel>
        </ui:Card>

        <ui:Card
            x:Name="TypeCard"
            Margin="0,3,0,0"
            Background="{DynamicResource CardStrokeColorDefaultBrush}"
            Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Symbol="Warning24" />

                    <ui:TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.ThemeImport.Type}"
                        TextWrapping="Wrap" />
                </Grid>

                <WrapPanel
                    x:Name="ThemeImportType"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</ui:ContentDialog>