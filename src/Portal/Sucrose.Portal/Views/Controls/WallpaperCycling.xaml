<ui:ContentDialog
    x:Class="Sucrose.Portal.Views.Controls.WallpaperCycling"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Portal.WallpaperCycling.Title}"
    d:DesignHeight="460"
    d:DesignWidth="640"
    CloseButtonText="{DynamicResource Portal.WallpaperCycling.Close}"
    DialogMaxWidth="750"
    Loaded="ContentDialog_Loaded"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:WallpaperCycling}" />
    </ui:ContentDialog.Resources>

    <StackPanel
        MinWidth="520"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Orientation="Vertical">
        <ui:Card Background="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <!--  Cycling  -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="DesktopSync24" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                        <ui:TextBlock Text="{DynamicResource Portal.WallpaperCycling.Cycling}" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Portal.WallpaperCycling.Cycling.Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ui:ToggleSwitch
                        x:Name="CyclingState"
                        Grid.Column="2"
                        VerticalAlignment="Center" />
                </Grid>

                <!--  Time  -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="Clock24" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                        <ui:TextBlock Text="{DynamicResource Portal.WallpaperCycling.Time}" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Portal.WallpaperCycling.Time.Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ui:NumberBox
                        x:Name="TimeDuration"
                        Grid.Column="2"
                        Width="170"
                        VerticalAlignment="Center"
                        ClearButtonEnabled="False"
                        Icon="{ui:SymbolIcon Timer24}"
                        IconPlacement="Left"
                        MaxDecimalPlaces="0"
                        MaxLength="5"
                        Maximum="99999"
                        Minimum="10" />
                </Grid>

                <!--  Transition  -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="ArrowShuffle24" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                        <ui:TextBlock Text="{DynamicResource Portal.WallpaperCycling.Transition}" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Portal.WallpaperCycling.Transition.Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox
                        x:Name="TransitionType"
                        Grid.Column="2"
                        Width="170"
                        VerticalAlignment="Center" />
                </Grid>

                <!--  List  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Symbol="TaskListSquareLtr24" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                        <ui:TextBlock Text="{DynamicResource Portal.WallpaperCycling.List}" />
                        <ui:TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{DynamicResource Portal.WallpaperCycling.List.Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ui:Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="ResetList_Click"
                        Content="{DynamicResource Portal.WallpaperCycling.List.Reset}"
                        Cursor="Hand" />
                </Grid>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</ui:ContentDialog>