<ui:ContentDialog
    x:Class="Sucrose.Portal.Views.Controls.ThemeCreate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Sucrose.Portal.Helpers"
    xmlns:local="clr-namespace:Sucrose.Portal.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{DynamicResource Portal.ThemeCreate.Title}"
    d:DesignHeight="750"
    d:DesignWidth="750"
    CloseButtonText="{DynamicResource Portal.ThemeCreate.Close}"
    DialogMaxWidth="750"
    IsPrimaryButtonEnabled="False"
    IsSecondaryButtonEnabled="False"
    Loaded="ContentDialog_Loaded"
    PreviewKeyDown="ContentDialog_PreviewKeyDown"
    PrimaryButtonText="{DynamicResource Portal.ThemeCreate.Create}"
    SecondaryButtonAppearance="Success"
    SecondaryButtonIcon="{ui:SymbolIcon Clock24}"
    SecondaryButtonText="{DynamicResource Portal.ThemeCreate.Creating}"
    mc:Ignorable="d">

    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:ThemeCreate}" />

        <Style
            x:Key="TypeTile"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="{x:Type ui:Button}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Regular" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="FieldLabelSpaced"
            BasedOn="{StaticResource FieldLabel}"
            TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="0,10,16,0" />
        </Style>

        <Style
            x:Key="FieldPicker"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="{x:Type ui:Button}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </ui:ContentDialog.Resources>

    <StackPanel
        x:Name="Root"
        MinWidth="620"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Orientation="Vertical">
        <StackPanel
            x:Name="CreateCard"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:Button
                    x:Name="GifCreate"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Click="GifCreate_Click"
                    Style="{StaticResource TypeTile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Symbol="Gif24" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Portal.ThemeCreate.Gif}" />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Portal.ThemeCreate.Gif.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="UrlCreate"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Click="UrlCreate_Click"
                    Style="{StaticResource TypeTile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Symbol="SlideLink24" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Portal.ThemeCreate.Url}" />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Portal.ThemeCreate.Url.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="WebCreate"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,10,5,0"
                    Click="WebCreate_Click"
                    Style="{StaticResource TypeTile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Symbol="GlobeDesktop24" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Portal.ThemeCreate.Web}" />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Portal.ThemeCreate.Web.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="VideoCreate"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,10,0,0"
                    Click="VideoCreate_Click"
                    Style="{StaticResource TypeTile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Symbol="VideoClip24" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Portal.ThemeCreate.Video}" />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Portal.ThemeCreate.Video.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="YouTubeCreate"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,10,5,0"
                    Click="YouTubeCreate_Click"
                    Style="{StaticResource TypeTile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Symbol="VideoRecording20" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Portal.ThemeCreate.YouTube}" />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Portal.ThemeCreate.YouTube.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    x:Name="ApplicationCreate"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5,10,0,0"
                    Click="ApplicationCreate_Click"
                    Style="{StaticResource TypeTile}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="28"
                            Symbol="AppGeneric24" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{DynamicResource Portal.ThemeCreate.Application}" />
                            <ui:TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{DynamicResource Portal.ThemeCreate.Application.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </StackPanel>

        <!--  Gif Theme  -->
        <StackPanel
            x:Name="GifCard"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    BorderBrush="Transparent"
                    Click="Back_Click"
                    Cursor="Hand"
                    Icon="{helpers:FlowDirectionIcon ArrowLeft24,
                                                     ArrowRight24}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.ThemeCreate.Gif}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.ThemeCreate.Gif.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="GifArea"
                MinHeight="150"
                Margin="0,0,0,12"
                AllowDrop="True"
                ClipToBounds="True"
                Cursor="Hand"
                DragLeave="GifArea_DragLeave"
                DragOver="GifArea_DragOver"
                Drop="GifArea_Drop"
                FlowDirection="LeftToRight"
                MouseLeftButtonUp="GifArea_MouseLeftButtonUp">
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" />

                <Image
                    x:Name="GifImagine"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FlowDirection="LeftToRight"
                    IsHitTestVisible="False"
                    Source="{x:Null}"
                    Stretch="UniformToFill"
                    StretchDirection="Both" />

                <Rectangle
                    x:Name="GifRectangle"
                    Margin="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stroke="{DynamicResource TextFillColorDisabledBrush}"
                    StrokeDashArray="4 4"
                    StrokeThickness="2" />

                <StackPanel
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon
                        x:Name="GifIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Symbol="SaveCopy24" />

                    <ui:TextBlock
                        x:Name="GifText"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.ThemeCreate.DragDrop.Gif}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <ui:Button
                        x:Name="GifDelete"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Appearance="Danger"
                        Click="GifDelete_Click"
                        Content="{DynamicResource Portal.ThemeCreate.DragDrop.Delete}"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon ArrowUndo24}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <ui:Card Background="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabel}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeThumbnail}" />
                    <ui:Button
                        x:Name="GifThumbnail"
                        Grid.Row="0"
                        Grid.Column="1"
                        Click="ThemeThumbnail_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemeThumbnail.Hint}"
                        Icon="{ui:SymbolIcon Image24}"
                        Style="{StaticResource FieldPicker}" />

                    <ui:TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemePreview}" />
                    <ui:Button
                        x:Name="GifPreview"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Click="ThemePreview_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemePreview.Hint}"
                        Icon="{ui:SymbolIcon Gif24}"
                        Style="{StaticResource FieldPicker}" />

                    <ui:TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeTitle}" />
                    <ui:TextBox
                        x:Name="GifTitle"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="50"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeTitle.Hint}" />

                    <ui:TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,11,16,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource FieldLabel}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeDescription}" />
                    <ui:TextBox
                        x:Name="GifDescription"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="500"
                        MaxLines="6"
                        MinLines="3"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeDescription.Hint}"
                        TextWrapping="WrapWithOverflow" />

                    <ui:TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeAuthor}" />
                    <ui:TextBox
                        x:Name="GifAuthor"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="50"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeAuthor.Hint}" />

                    <ui:TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeContact}" />
                    <ui:TextBox
                        x:Name="GifContact"
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="250"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeContact.Hint}" />

                    <ui:TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeTags}" />
                    <ui:TextBox
                        x:Name="GifTags"
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="104"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeTags.Hint}" />
                </Grid>
            </ui:Card>
        </StackPanel>

        <!--  Url Theme  -->
        <StackPanel
            x:Name="UrlCard"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    BorderBrush="Transparent"
                    Click="Back_Click"
                    Cursor="Hand"
                    Icon="{helpers:FlowDirectionIcon ArrowLeft24,
                                                     ArrowRight24}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.ThemeCreate.Url}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.ThemeCreate.Url.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ui:Card Background="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabel}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeUrl}" />
                    <ui:TextBox
                        x:Name="UrlUrl"
                        Grid.Row="0"
                        Grid.Column="1"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="250"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeUrl.Hint}" />

                    <ui:TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeThumbnail}" />
                    <ui:Button
                        x:Name="UrlThumbnail"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Click="ThemeThumbnail_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemeThumbnail.Hint}"
                        Icon="{ui:SymbolIcon Image24}"
                        Style="{StaticResource FieldPicker}" />

                    <ui:TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemePreview}" />
                    <ui:Button
                        x:Name="UrlPreview"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Click="ThemePreview_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemePreview.Hint}"
                        Icon="{ui:SymbolIcon Gif24}"
                        Style="{StaticResource FieldPicker}" />

                    <ui:TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeTitle}" />
                    <ui:TextBox
                        x:Name="UrlTitle"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="50"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeTitle.Hint}" />

                    <ui:TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,11,16,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource FieldLabel}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeDescription}" />
                    <ui:TextBox
                        x:Name="UrlDescription"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="500"
                        MaxLines="6"
                        MinLines="3"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeDescription.Hint}"
                        TextWrapping="WrapWithOverflow" />

                    <ui:TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeAuthor}" />
                    <ui:TextBox
                        x:Name="UrlAuthor"
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="50"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeAuthor.Hint}" />

                    <ui:TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeContact}" />
                    <ui:TextBox
                        x:Name="UrlContact"
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="250"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeContact.Hint}" />

                    <ui:TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeTags}" />
                    <ui:TextBox
                        x:Name="UrlTags"
                        Grid.Row="7"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="104"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeTags.Hint}" />
                </Grid>
            </ui:Card>
        </StackPanel>

        <!--  Web Theme  -->
        <StackPanel
            x:Name="WebCard"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="Collapsed">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    BorderBrush="Transparent"
                    Click="Back_Click"
                    Cursor="Hand"
                    Icon="{helpers:FlowDirectionIcon ArrowLeft24,
                                                     ArrowRight24}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{DynamicResource Portal.ThemeCreate.Web}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{DynamicResource Portal.ThemeCreate.Web.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ui:Card Background="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabel}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeWeb}" />
                    <ui:Button
                        x:Name="WebSource"
                        Grid.Row="0"
                        Grid.Column="1"
                        Click="WebSource_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemeWeb.Hint}"
                        Icon="{ui:SymbolIcon GlobeDesktop24}"
                        Style="{StaticResource FieldPicker}" />
                    <ui:Button
                        x:Name="WebSourceClear"
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Appearance="Secondary"
                        Click="WebSourceClear_Click"
                        Cursor="Hand"
                        Icon="{ui:SymbolIcon Delete24}" />

                    <ui:TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeThumbnail}" />
                    <ui:Button
                        x:Name="WebThumbnail"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Click="ThemeThumbnail_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemeThumbnail.Hint}"
                        Icon="{ui:SymbolIcon Image24}"
                        Style="{StaticResource FieldPicker}" />

                    <ui:TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemePreview}" />
                    <ui:Button
                        x:Name="WebPreview"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        Click="ThemePreview_Click"
                        Content="{DynamicResource Portal.ThemeCreate.ThemePreview.Hint}"
                        Icon="{ui:SymbolIcon Gif24}"
                        Style="{StaticResource FieldPicker}" />

                    <ui:TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource FieldLabelSpaced}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeTitle}" />
                    <ui:TextBox
                        x:Name="WebTitle"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        MaxLength="50"
                        PlaceholderText="{DynamicResource Portal.ThemeCreate.ThemeTitle.Hint}" />

                    <ui:TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,11,16,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource FieldLabel}"
                        Text="{DynamicResource Portal.ThemeCreate.ThemeDescription}" />
                    <ui:TextBox
                        x:Name="WebDescription"
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,10,0,0"
                        AcceptsReturn="False"
