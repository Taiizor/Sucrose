<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  The application manifest of sucrose.exe, embedded by build.rs. The binary is also CEF's GPU, renderer and utility
  subprocess (D-036). Chromium's GPU process needs the Windows 10 supportedOS entry that CEF's sample executables carry
  (compatibility.manifest): without it the GPU process crashes on its first command buffer and no page gets WebGL.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
