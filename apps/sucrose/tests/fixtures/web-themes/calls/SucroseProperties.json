    "secret": {
      "type": "passwordbox",
      "text": "Secret",
      "value": "hunter2"
    },
    "picture": {
      "type": "filedropdown",
      "text": "Media",
      "desc": "Text and images",
      "value": "one.txt",
      "title": "Pick a file",
      "folder": "media",
      "filter": "*.txt|*.png"
    },
    "tint": {
      "type": "colorpicker",
      "text": "Tint",
      "value": "#FF00FF00"
    }
